DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: leave unset to use a local SQLite file (zero setup). Set this to
# use Postgres instead — either the local docker-compose db:
# DATABASE_URL=postgres://eld_user:eld_pass@localhost:5432/eld_trip_planner
# ...or a managed free Postgres (Neon.tech, Supabase) in production.
DATABASE_URL=
