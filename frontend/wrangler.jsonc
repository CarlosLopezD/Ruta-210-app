{
  "name": "ruta-210-app",
  "compatibility_date": "2026-01-01",
  // Reverse proxy in front of the static build (see worker/index.ts) — makes
  // the frontend and the Django API same-site so the refresh-token cookie
  // (SameSite=Lax, see backend/accounts/cookies.py) can be sent at all.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* is routed through the Worker's fetch handler above;
    // everything else is served directly from the static build without
    // running any Worker code.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://eld-trip-planner-api-wkzt.onrender.com"
  }
}
